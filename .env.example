VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Required for Concept2 connect/sync flows.
VITE_CONCEPT2_CLIENT_ID=your-concept2-client-id
VITE_CONCEPT2_CLIENT_SECRET=your-concept2-client-secret

# Optional: only needed for local admin/backfill scripts that must bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── ChatGPT MCP connector (api/mcp.ts) ────────────────────────────────
# OAuth 2.1: Supabase Auth is the authorization server; /api/mcp is the
# resource server. Each request carries a Supabase-issued access token (JWT),
# verified against the project JWKS; queries run under the user's identity so
# RLS scopes the data. No service-role key, no shared secret, no hardcoded user.
#
# Server-side only. SUPABASE_URL/ANON_KEY fall back to the VITE_ vars if unset.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Optional overrides (derived from SUPABASE_URL by default):
# MCP_OAUTH_ISSUER=https://your-project.supabase.co/auth/v1
# MCP_OAUTH_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
# MCP_SITE_URL=https://logbook.readyall.org
# MCP_RESOURCE_URL=https://logbook.readyall.org/api/mcp
# Set to "true" ONLY for local testing to skip token verification. Never in prod.
# MCP_DISABLE_AUTH=false
