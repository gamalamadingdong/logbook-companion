VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Required for Concept2 connect/sync flows.
VITE_CONCEPT2_CLIENT_ID=your-concept2-client-id
VITE_CONCEPT2_CLIENT_SECRET=your-concept2-client-secret

# Optional: only needed for local admin/backfill scripts that must bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── ChatGPT MCP connector (api/mcp.ts) ────────────────────────────────
# Server-side only. Never expose the service-role key to the browser bundle.
# SUPABASE_URL falls back to VITE_SUPABASE_URL if unset.
SUPABASE_URL=https://your-project.supabase.co
# The single athlete whose data the connector exposes (hard-scoped in code).
LOGBOOK_USER_ID=your-supabase-auth-user-uuid
# Shared secret ChatGPT sends as `Authorization: Bearer <token>`.
# Generate with: openssl rand -hex 32
MCP_BEARER_TOKEN=your-long-random-secret
# Set to "true" only for local testing to skip bearer auth. Never in prod.
# MCP_DISABLE_AUTH=false
